# Copy to .env on the hub Mac and fill in. .env is git-ignored. Values here are fake.

# Full HTTPS URL that tailscale serve publishes, e.g. https://<hub-machine-name>.<tailnet>.ts.net:8443
VAULT_DOMAIN=https://hub.example-tailnet.ts.net:8443

# Admin page token. Generate an Argon2 PHC hash with:  docker run --rm -it vaultwarden/server /vaultwarden hash
# Leave commented out to keep the /admin page disabled (recommended after first setup).
# ADMIN_TOKEN=

# Where nightly vault backups land (a folder synced to the NAS or an external disk)
BACKUP_DIR=./backups

# Only for creating your own account the first time; keep false otherwise.
VAULT_SIGNUPS_ALLOWED=false

{
 "uid": "home-overview",
 "title": "Home overview",
 "tags": [
  "home"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Now",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Firing alerts",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Targets down",
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(up == 0) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "Exposed listeners",
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(home_security_exposed_listeners) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "Failed Mac logins (24h)",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_security_failed_logins_total[24h])) or vector(0)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 5
  },
  {
   "type": "stat",
   "title": "Spend this month (CAD)",
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(home_agents_spend_cad{period=\"month\"})",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyCAD",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 6
  },
  {
   "type": "stat",
   "title": "Of monthly cap",
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(home_agents_spend_cad{period=\"month\"}) / sum(home_agents_spend_limit_cad{period=\"month\"})",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "id": 7
  },
  {
   "type": "row",
   "title": "Macs",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "CPU busy",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "Swap used",
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_swap_used_bytes",
     "legendFormat": "{{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "Disk free",
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_filesystem_avail_bytes{mountpoint=~\"/|/System/Volumes/Data\"} / node_filesystem_size_bytes{mountpoint=~\"/|/System/Volumes/Data\"}",
     "legendFormat": "{{host}} {{mountpoint}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "id": 11
  },
  {
   "type": "row",
   "title": "Containers",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 12
  },
  {
   "type": "timeseries",
   "title": "Memory (working set)",
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "container_memory_working_set_bytes{name!=\"\"}",
     "legendFormat": "{{host}} {{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "id": 13
  },
  {
   "type": "timeseries",
   "title": "CPU",
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])",
     "legendFormat": "{{host}} {{name}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "id": 14
  },
  {
   "type": "row",
   "title": "House and agents",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 15
  },
  {
   "type": "timeseries",
   "title": "Scrape targets up",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up",
     "legendFormat": "{{job}} {{host}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "id": 16
  },
  {
   "type": "timeseries",
   "title": "Model spend (CAD)",
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "home_agents_spend_cad",
     "legendFormat": "spent {{period}}"
    },
    {
     "refId": "B",
     "expr": "home_agents_spend_limit_cad",
     "legendFormat": "limit {{period}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyCAD"
    },
    "overrides": []
   },
   "id": 17
  },
  {
   "type": "timeseries",
   "title": "Agent tasks and approvals",
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "home_agents_tasks",
     "legendFormat": "{{state}}"
    },
    {
     "refId": "B",
     "expr": "home_agents_approvals_pending",
     "legendFormat": "approvals waiting"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "id": 18
  },
  {
   "type": "row",
   "title": "Security logs",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 19
  },
  {
   "type": "logs",
   "title": "Mac security log and vault logins",
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{job=\"macos\"}"
    },
    {
     "refId": "B",
     "expr": "{container=\"vaultwarden\"} |~ \"(?i)incorrect|failed|admin\""
    }
   ],
   "id": 20
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}

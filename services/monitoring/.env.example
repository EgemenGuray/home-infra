# Copy to .env (git-ignored) and fill in. Values here are fake. Real values: home-private-config.

# Which setup this Mac mini is in (see README.md):
#   Mac mini only:          COMPOSE_PROFILES=ui
#   Mac mini + Mac Studio:  COMPOSE_PROFILES=     and set LOKI_URL to the Studio's Loki below
COMPOSE_PROFILES=ui

# Tailnet URLs that tailscale serve publishes (machine name + tailnet name from the admin console).
GRAFANA_ROOT_URL=https://hub.example-tailnet.ts.net:4443
NTFY_BASE_URL=https://hub.example-tailnet.ts.net:2443

# Where Alloy sends logs. Mac mini only: leave as is. With the Studio:
#   LOKI_URL=https://studio.example-tailnet.ts.net:3143/loki/api/v1/push
LOKI_URL=http://loki:3100/loki/api/v1/push

# Retention. Prometheus stops at whichever limit comes first.
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=1GB
LOKI_RETENTION=168h

# Folder on the Mac where security-checks.sh writes its log (shipped to Loki).
HOST_LOG_DIR=/usr/local/var/log/home-hub

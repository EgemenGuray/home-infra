# Mac mini + Mac Studio setup only. Copy to studio/.env on the Studio (git-ignored). Fake values.
GRAFANA_ROOT_URL=https://studio.example-tailnet.ts.net:4443
# The Mac mini's Prometheus and Alertmanager, published to the tailnet by tailscale-serve.sh --with-studio
PROMETHEUS_URL=https://hub.example-tailnet.ts.net:9443
ALERTMANAGER_URL=https://hub.example-tailnet.ts.net:9493
# 30 days of logs; the Studio has the disk for it.
LOKI_RETENTION=720h
HOST_LOG_DIR=/usr/local/var/log/home-hub
